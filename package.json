{
  "name": "mdrfc",
  "version": "0.1.1",
  "description": "Simple markdown viewer — terminal + web. RFC-style monospace, 72-col width.",
  "keywords": [
    "markdown",
    "viewer",
    "cli",
    "terminal",
    "rfc",
    "live-reload",
    "preview",
    "monospace"
  ],
  "homepage": "https://github.com/riadafridishibly/mdrfc#readme",
  "bugs": "https://github.com/riadafridishibly/mdrfc/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riadafridishibly/mdrfc.git"
  },
  "license": "MIT",
  "author": "Riad Afridi Shibly",
  "type": "module",
  "bin": {
    "mdrfc": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node src/main.ts",
    "start": "node src/main.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.cpSync('src/client','dist/client',{recursive:true});fs.cpSync('src/webfonts','dist/webfonts',{recursive:true,filter:s=>!s.endsWith('RANGES')});fs.chmodSync('dist/main.js',0o755)\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "fzf": "0.5.2",
    "htm": "^3.1.1",
    "marked": "^15",
    "marked-terminal": "^7.3.0",
    "preact": "^10.29.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/node": "^24.10.1",
    "happy-dom": "^20.11.1",
    "typescript": "^5.9.3"
  }
}
